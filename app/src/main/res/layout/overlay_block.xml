<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:fontFamily="@font/pixelbasel"
            android:layout_height="wrap_content"
            android:text="@string/setup_eyebrow"
            android:textColor="#7E7E8F"
            android:textSize="14sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayAppLabel"
            android:layout_width="wrap_content"
            android:fontFamily="@font/pixelbasel"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#F5F5F8"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:fontFamily="@font/pixelbasel"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/block_locked"
            android:textColor="#9A9AAE"
            android:textSize="18sp" />

        <Button
            android:id="@+id/overlayDismiss"
            android:layout_width="match_parent"
            android:fontFamily="@font/pixelbasel"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/block_dismiss"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2B2B36" />

        <TextView
            android:id="@+id/overlayBypass"
            android:layout_width="wrap_content"
            android:fontFamily="@font/pixelbasel"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="10dp"
            android:textColor="#2B2B36"
            android:textSize="15sp" />

    </LinearLayout>

</FrameLayout>
